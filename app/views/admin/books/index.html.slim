h1 Admin - Manage Books

= link_to 'New Book', new_admin_book_path, class: 'btn btn-primary'

table.table.table-hover
  thead
    tr
      th Title
      th Content
      th Actions
  tbody
    - @books.each do |book|
      tr
        td = book.title
        td = book.content
        td
          = link_to 'Edit', edit_admin_book_path(book), class: 'btn btn-warning'
          = link_to 'Delete', admin_book_path(book), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' 